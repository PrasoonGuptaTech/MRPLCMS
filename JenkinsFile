pipeline {
    agent any

    tools {
        nodejs 'Node23'
    }

    environment {
        ANDROID_HOME = "/opt/android-sdk"
        ANDROID_SDK_ROOT = "/opt/android-sdk"
        PATH = "${ANDROID_HOME}/platform-tools:${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                sh 'node -v'
                sh 'npm -v'
                sh 'npm ci'
            }
        }

        stage('Static Analysis') {
            steps {
                sh 'npm run format:check'
                sh 'npm run lint -- --max-warnings=0'
                sh 'npm run typecheck'
            }
        }

        stage('Test') {
            steps {
                sh 'npm run test:ci'
            }
        }

        stage('Check Android SDK') {
            steps {
                sh '''
                    echo "ANDROID_HOME=$ANDROID_HOME"
                    echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"
                    ls -la $ANDROID_HOME
                '''
            }
        }

        stage('Build Android') {
            steps {
                dir('android') {
                    sh './gradlew assembleDebug'
                }
            }
        }
    }
}
